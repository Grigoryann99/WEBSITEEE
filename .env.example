# Configure values locally or in your hosting environment. Never commit actual secrets.
NEXT_PUBLIC_SUPABASE_URL=
# local (default) or supabase; Supabase published content is pulled before build.
# Enable supabase only after the content migration and hosted verification.
CONTENT_SOURCE=local
# Local administrative backup/import only. Never prefix this with NEXT_PUBLIC_.
# Keep the real password only in an ignored local env file.
SUPABASE_DB_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Add a provider only AFTER enabling it in Supabase and its provider console.
NEXT_PUBLIC_AUTH_PROVIDERS=google,apple,azure
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
